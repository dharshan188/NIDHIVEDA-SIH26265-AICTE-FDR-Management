{
  "id": "S12",
  "title": "Migrating legacy records without marking them verified, blocking refunds, or forcing resubmission",
  "reviewer_ref": "Round 4: final AICTE question (10,000 historical records)",
  "steps": [
    {"do": "bank", "bank": "SBI", "key": "SBI-K1", "valid_from": "2010-01-01", "at": "2010-01-01T09:00"},
    {"do": "bank", "bank": "PNB", "key": "PNB-K1", "valid_from": "2010-01-01", "at": "2010-01-01T09:01"},
    {"do": "institution", "inst_id": "INST-A", "name": "Alpha Institute of Technology", "known_accounts": ["A-CUR-5010"], "at": "2011-01-01T09:00"},
    {"note": "AICTE's own historical bank statement lines (obtainable from AICTE's banker without involving institutions)."},
    {"do": "evidence", "id": "S-1", "key": "SBI-K1", "kind": "credit_advice", "at": "2013-01-10T10:00", "payload": {"utr": "OLD-1", "amount_lakh": 15, "value_date": "2013-01-10", "remitter_account": "A-CUR-5010", "narrative": "SD"}},
    {"do": "evidence", "id": "S-2", "key": "SBI-K1", "kind": "credit_advice", "at": "2013-02-10T10:00", "payload": {"utr": "OLD-2", "amount_lakh": 10, "value_date": "2013-02-10", "narrative": "SD"}},
    {"do": "evidence", "id": "S-5", "key": "SBI-K1", "kind": "credit_advice", "at": "2013-03-10T10:00", "payload": {"utr": "OLD-5", "amount_lakh": 8, "value_date": "2013-03-10", "narrative": "SD"}},
    {"do": "legacy_import", "batch_id": "MIG-2026-01", "at": "2026-08-01T09:00", "records": [
      {"legacy_id": "L1", "inst_id": "INST-A", "amount_lakh": 15, "instrument_class": "ONLINE", "utr": "OLD-1"},
      {"legacy_id": "L2", "inst_id": "INST-B", "inst_name": "Beta College of Engineering", "amount_lakh": 10, "instrument_class": "ONLINE", "utr": "OLD-2"},
      {"legacy_id": "L3", "inst_id": "INST-C", "inst_name": "Gamma School of Planning", "amount_lakh": 5, "instrument_class": "ONLINE"},
      {"legacy_id": "L4", "inst_id": "INST-D", "inst_name": "Delta Polytechnic", "amount_lakh": 15, "instrument_class": "FDR", "fdr_number": "PNB-FD-OLD4", "bank": "PNB", "issue_date": "2012-04-01", "maturity_date": "2032-04-01"},
      {"legacy_id": "L5", "inst_id": "INST-E", "inst_name": "Epsilon Institute", "amount_lakh": 8, "instrument_class": "ONLINE", "utr": "OLD-5"},
      {"legacy_id": "L6", "inst_id": "INST-F", "inst_name": "Zeta College", "amount_lakh": 8, "instrument_class": "ONLINE", "utr": "OLD-5"},
      {"legacy_id": "L7", "inst_id": "INST-A", "amount_lakh": 15, "instrument_class": "ONLINE", "utr": "OLD-1"}
    ]},
    {"expect": "result", "path": "linked_to_bank_credit", "equals": 3},
    {"expect": "result", "path": "declared_only", "equals": 1},
    {"expect": "result", "path": "disputed", "equals": 1},
    {"expect": "result", "path": "flagged_duplicate", "equals": 1},
    {"expect": "result", "path": "fdr_registered", "equals": 1},
    {"note": "Nothing became TRACEABLE. L1 is CORROBORATED only because AICTE's bank statement shows A's own account as remitter."},
    {"expect": "confidence", "alloc": "A-LEG-L1", "equals": "CORROBORATED"},
    {"expect": "confidence", "alloc": "A-LEG-L2", "equals": "LEGACY_DECLARED"},
    {"expect": "confidence", "alloc": "A-LEG-L5", "equals": "UNCERTAIN"},
    {"expect": "value", "of": "holds", "len": 0},
    {"expect": "no_notification", "kind": "refund_returned"},
