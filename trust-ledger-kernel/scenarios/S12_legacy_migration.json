    {"expect": "notification", "to": "finance", "kind": "attribution_dispute", "contains": "INST-E"},
    {"note": "Release of the legacy FDR: blocked only until a just-in-time bank confirmation arrives. The institution resubmits nothing."},
    {"do": "entitlement", "obligation_id": "LEG-L4", "basis": "Closure approved", "at": "2026-09-01T10:00", "actor": "section_officer:kiran"},
    {"do": "affidavit", "obligation_id": "LEG-L4", "kind": "AFFIDAVIT-6", "format_ok": true, "at": "2026-09-01T10:01", "actor": "section_officer:kiran"},
    {"expect": "release", "obligation": "LEG-L4", "at": "2026-09-01T11:00", "approver": "deputy_director:meera", "allowed": false, "blocked_by_includes": ["M_CURRENT_INSTRUMENT"]},
    {"do": "evidence", "id": "E-JIT", "key": "PNB-K1", "kind": "instrument_confirmation", "at": "2026-09-02T10:00", "payload": {"instrument_no": "PNB-FD-OLD4", "amount_lakh": 15, "maturity_date": "2032-04-01", "status": "ACTIVE", "lien_holder": "AICTE", "as_of": "2026-09-02"}},
    {"expect": "release", "obligation": "LEG-L4", "at": "2026-09-02T11:00", "approver": "deputy_director:meera", "allowed": true, "instrument_no": "PNB-FD-OLD4"},
    {"note": "Release of L1 (corroborated by bank evidence) is not blocked on attribution."},
    {"do": "entitlement", "obligation_id": "LEG-L1", "basis": "Closure approved", "at": "2026-09-02T12:00", "actor": "section_officer:kiran"},
    {"expect": "release", "obligation": "LEG-L1", "at": "2026-09-02T12:30", "approver": "deputy_director:meera", "allowed": false, "not_blocked_by": ["M_ATTRIBUTION"], "releasable_lakh": 15},
    {"expect": "value", "of": "confirmation_requests", "len": 1},
    {"expect": "chain", "valid": true},
    {"expect": "replay_matches"}
  ]
}
