{
  "id": "S04",
  "title": "Rs 20 lakh legacy credit mis-attributed; both institutions silent; pool still matches",
  "reviewer_ref": "Round 4: Issue 2, Question 7 (the trust test), Question 8 (annual confirmations)",
  "steps": [
    {"do": "bank", "bank": "SBI", "key": "SBI-K1", "valid_from": "2010-01-01", "at": "2010-01-01T09:00"},
    {"do": "institution", "inst_id": "INST-A", "name": "Alpha Institute of Technology", "known_accounts": ["A-CUR-5010"], "at": "2012-01-01T09:00"},
    {"do": "institution", "inst_id": "INST-B", "name": "Beta College of Engineering", "known_accounts": ["B-CUR-7700"], "at": "2012-01-01T09:00"},
    {"note": "AICTE's own 2012 bank statement line: UTR and amount only, no remitter details (as old statements often are)."},
    {"do": "evidence", "id": "E-OLD-77", "key": "SBI-K1", "kind": "credit_advice", "at": "2012-03-01T10:00",
     "payload": {"utr": "OLD-77", "amount_lakh": 20, "value_date": "2012-03-01", "narrative": "SECURITY DEPOSIT"}},
    {"note": "Legacy register (migrated) says this credit belongs to A. It is actually B's."},
    {"do": "legacy_import", "batch_id": "MIG-1", "at": "2026-08-01T09:00",
     "records": [{"legacy_id": "L1", "inst_id": "INST-A", "amount_lakh": 20, "instrument_class": "ONLINE", "utr": "OLD-77", "programme": "Diploma"}]},
    {"expect": "confidence", "alloc": "A-LEG-L1", "equals": "LEGACY_DECLARED"},
    {"do": "evidence", "id": "E-POOL", "key": "SBI-K1", "kind": "pooled_balance", "at": "2026-08-02T09:00", "payload": {"balance_lakh": 20, "as_of": "2026-08-01"}},
    {"expect": "value", "of": "certification_report", "path": "aggregate_matches", "equals": true},
    {"expect": "value", "of": "certification_report", "path": "per_institution.INST-A.certifiable", "equals_lakh": 0},
    {"expect": "value", "of": "certification_report", "path": "per_institution.INST-A.declared_not_certifiable", "equals_lakh": 20},
    {"note": "No annual confirmation is sent: nothing conflicts yet. A year passes with no response from anyone; nothing changes and nobody is penalised."},
    {"expect": "value", "of": "confirmation_requests", "len": 0},
    {"do": "tick", "at": "2027-08-01T09:00"},
    {"expect": "confidence", "alloc": "A-LEG-L1", "equals": "LEGACY_DECLARED"},
    {"expect": "value", "of": "holds", "len": 0},
    {"expect": "value", "of": "outbox", "len": 0},
    {"note": "A asks for release. The gate does not pretend: Rs 20 lakh is not proven to be A's."},
    {"do": "entitlement", "obligation_id": "LEG-L1", "basis": "Closure approved", "at": "2027-08-02T10:00", "actor": "section_officer:kiran"},
    {"expect": "release", "obligation": "LEG-L1", "at": "2027-08-02T11:00", "approver": "deputy_director:meera", "allowed": false, "blocked_by_includes": ["M_ATTRIBUTION"], "releasable_lakh": 0},
    {"note": "Just-in-time check: AICTE asks its own bank for the remitter of UTR OLD-77 (no institution resubmits anything)."},
    {"do": "evidence", "id": "E-REM-77", "key": "SBI-K1", "kind": "remitter_details", "at": "2027-08-05T10:00",
     "payload": {"utr": "OLD-77", "remitter_name": "Beta College of Engineering", "remitter_account": "B-CUR-7700"}},
    {"note": "Bank says the money came from Beta's registered account: the item turns UNCERTAIN automatically and only now is anyone asked to confirm."},
    {"expect": "confidence", "alloc": "A-LEG-L1", "equals": "UNCERTAIN"},
    {"expect": "value", "of": "confirmation_requests", "len": 1},
    {"do": "dispute", "dispute_id": "D-77", "credit_id": "CR-OLD-77", "claimants": ["INST-A", "INST-B"], "basis": "Bank remitter details show Beta College, register says Alpha", "at": "2027-08-05T11:00", "actor": "finance_reconciliation_officer:anil"},
    {"expect": "confidence", "alloc": "A-LEG-L1", "equals": "UNCERTAIN"},
    {"expect": "value", "of": "certification_report", "path": "per_institution.INST-A.uncertain", "equals_lakh": 20},
    {"do": "resolve_dispute", "dispute_id": "D-77", "at": "2027-08-20T10:00", "actor": "director:sunil", "reference": "Order F.No.77/2027: credit belongs to Beta", "award": {"A-LEG-L1": 0}},
    {"do": "obligation", "obligation_id": "O-B", "inst_id": "INST-B", "programme": "Diploma", "amount_lakh": 20, "instrument_class": "ONLINE", "at": "2027-08-20T10:05", "actor": "section_officer:kiran"},
    {"do": "allocate", "alloc_id": "A-B", "credit_id": "CR-OLD-77", "obligation_id": "O-B", "amount_lakh": 20, "basis": "reconciliation_officer", "at": "2027-08-20T10:10", "actor": "finance_reconciliation_officer:anil"},
    {"expect": "confidence", "alloc": "A-B", "equals": "CORROBORATED"},
    {"expect": "value", "of": "certification_report", "path": "per_institution.INST-B.certifiable", "equals_lakh": 20},
    {"expect": "value", "of": "allocations", "path": "A-LEG-L1.active", "equals": false},
    {"expect": "chain", "valid": true},
    {"expect": "replay_matches"}
  ]
}
