{
  "id": "S07",
  "title": "Manual renewal after maturity: prohibited in one edition, unspecified in another",
  "reviewer_ref": "Round 4: Issue 5 (demo must not perform a prohibited renewal), P1 historical renewal rules",
  "steps": [
    {"do": "bank", "bank": "PNB", "key": "PNB-K1", "valid_from": "2010-01-01", "at": "2010-01-01T09:00"},
    {"do": "institution", "inst_id": "INST-D", "name": "Delta Polytechnic", "at": "2013-01-01T09:00"},
    {"do": "obligation", "obligation_id": "OD", "inst_id": "INST-D", "programme": "Diploma", "amount_lakh": 15, "instrument_class": "FDR", "at": "2013-01-02T09:00"},
    {"do": "instrument", "instrument_id": "ID", "obligation_id": "OD", "number": "PNB-FD-3001", "bank": "PNB", "amount_lakh": 15, "issue_date": "2013-11-30", "maturity_date": "2018-11-30", "at": "2013-12-01T09:00", "actor": "institution:INST-D"},
    {"note": "Dec 2018: institution asks to renew an FDR that matured on 30 Nov 2018."},
    {"do": "renewal_request", "instrument_id": "ID", "renewal_date": "2018-12-20", "new_number": "PNB-FD-3002", "new_maturity": "2023-12-20", "at": "2018-12-20T10:00", "actor": "section_officer:kiran"},
    {"expect": "result", "equals": "ESCALATED_TO_LEGAL_CELL"},
