    {"do": "confirm_pack", "edition_id": "APH-2018-19", "at": "2018-12-21T10:00", "actor": "legal_cell:asha", "reference": "LC/2018/31"},
    {"do": "renewal_request", "instrument_id": "ID", "renewal_date": "2018-12-20", "new_number": "PNB-FD-3002", "new_maturity": "2023-12-20", "at": "2018-12-21T11:00", "actor": "section_officer:kiran"},
    {"expect": "result", "equals": "REJECTED"},
    {"expect": "notification", "to": "institution:INST-D", "kind": "renewal_rejected", "contains": "Cl. 5.34.2"},
    {"note": "A different FDR matures in 2025, under APH 2024-27, which (as far as we found) says nothing about post-maturity renewal."},
    {"do": "obligation", "obligation_id": "OE", "inst_id": "INST-D", "programme": "UG", "amount_lakh": 35, "instrument_class": "FDR", "at": "2020-01-02T09:00"},
    {"do": "instrument", "instrument_id": "IE", "obligation_id": "OE", "number": "PNB-FD-4001", "bank": "PNB", "amount_lakh": 35, "issue_date": "2020-05-31", "maturity_date": "2025-05-31", "at": "2020-06-01T09:00", "actor": "institution:INST-D"},
    {"do": "renewal_request", "instrument_id": "IE", "renewal_date": "2025-06-10", "new_number": "PNB-FD-4002", "new_maturity": "2030-06-10", "at": "2025-06-10T10:00", "actor": "section_officer:kiran"},
    {"expect": "result", "equals": "ESCALATED_TO_LEGAL_CELL"},
    {"do": "ruling", "case_id": "IE", "key": "fdr.manual_renewal_after_maturity", "on_date": "2025-06-10", "value": "permitted", "reference": "LC/2025/88: renewal allowed, lien to continue", "at": "2025-06-12T10:00", "actor": "legal_cell:asha"},
    {"do": "renewal_request", "instrument_id": "IE", "renewal_date": "2025-06-10", "new_number": "PNB-FD-4002", "new_maturity": "2030-06-10", "at": "2025-06-12T11:00", "actor": "section_officer:kiran"},
    {"expect": "result", "equals": "ACCEPTED_PENDING_BANK_CONFIRMATION"},
