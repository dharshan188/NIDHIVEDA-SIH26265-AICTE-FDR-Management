    {"do": "obligation", "obligation_id": "OG", "inst_id": "INST-D", "programme": "PG", "amount_lakh": 15, "instrument_class": "FDR", "at": "2025-06-13T09:00"},
    {"do": "instrument", "instrument_id": "IG", "obligation_id": "OG", "number": "PNB-FD-5001", "bank": "PNB", "amount_lakh": 15, "issue_date": "2021-01-01", "maturity_date": "2026-01-01", "at": "2025-06-13T09:05", "actor": "institution:INST-D"},
    {"do": "renewal_request", "instrument_id": "IG", "renewal_date": "2025-12-15", "new_number": "PNB-FD-5002", "new_maturity": "2030-12-15", "at": "2025-12-15T10:00", "actor": "section_officer:kiran"},
    {"expect": "result", "equals": "ACCEPTED_PENDING_BANK_CONFIRMATION"},
