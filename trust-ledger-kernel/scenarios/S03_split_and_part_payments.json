    {"do": "allocate", "alloc_id": "A-MCA-2", "credit_id": "CR-UTR-P2", "obligation_id": "O-MCA", "amount_lakh": 5, "basis": "machine_reference", "at": "2026-05-20T10:07", "actor": "system:auto_match"},
