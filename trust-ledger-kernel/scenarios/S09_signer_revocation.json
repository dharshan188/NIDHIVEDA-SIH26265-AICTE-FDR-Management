{
  "id": "S09",
  "title": "Bank signer's authority ends vs. bank signer's key is compromised (with back-dating attempt)",
  "reviewer_ref": "Rounds 2-4: Bank Authority Registry and revocation cascade (now executable)",
  "steps": [
    {"do": "bank", "bank": "SBI", "key": "SBI-K1", "valid_from": "2015-01-01", "at": "2015-01-01T09:00"},
    {"do": "bank", "bank": "SBI", "key": "SBI-K2", "valid_from": "2015-01-01", "at": "2015-01-01T09:01"},
    {"do": "institution", "inst_id": "INST-A", "name": "Alpha Institute of Technology", "known_accounts": ["A-CUR-5010"], "at": "2025-01-01T09:00"},
    {"do": "obligation", "obligation_id": "OY", "inst_id": "INST-A", "programme": "UG", "amount_lakh": 15, "instrument_class": "ONLINE", "reference": "APP-Y", "at": "2025-01-02T09:00"},
    {"do": "obligation", "obligation_id": "OZ", "inst_id": "INST-A", "programme": "PG", "amount_lakh": 15, "instrument_class": "ONLINE", "reference": "APP-Z", "at": "2025-01-02T09:00"},
    {"do": "evidence", "id": "E-Y", "key": "SBI-K1", "kind": "credit_advice", "at": "2025-06-01T10:00", "payload": {"utr": "UTR-Y", "amount_lakh": 15, "value_date": "2025-06-01", "narrative": "APP-Y"}},
    {"do": "allocate", "alloc_id": "AY", "credit_id": "CR-UTR-Y", "obligation_id": "OY", "amount_lakh": 15, "basis": "machine_reference", "at": "2025-06-01T10:05", "actor": "system:auto_match"},
    {"do": "payee", "inst_id": "INST-A", "account": "A-CUR-5010", "ifsc": "SBIN0001234", "name": "Alpha Institute of Technology", "at": "2025-12-01T10:00", "actor": "institution:INST-A"},
    {"do": "evidence", "id": "E-NL", "key": "SBI-K1", "kind": "name_lookup", "at": "2025-12-01T11:00", "payload": {"account": "A-CUR-5010", "ifsc": "SBIN0001234", "name_at_bank": "Alpha Institute of Technology"}},
    {"note": "Officer behind K1 is transferred on 1 Jan 2026: an ordinary END of authority."},
    {"do": "end_signer", "key_id": "SBI-K1", "ended_at": "2026-01-01T00:00", "at": "2026-01-02T09:00"},
    {"expect": "confidence", "alloc": "AY", "equals": "TRACEABLE"},
    {"expect": "error", "code": "InvalidEvidence", "step": {"do": "evidence", "id": "E-LATE", "key": "SBI-K1", "kind": "credit_advice", "at": "2026-02-01T10:00", "payload": {"utr": "UTR-LATE", "amount_lakh": 1, "value_date": "2026-02-01", "narrative": "x"}}},
    {"expect": "notification", "to": "internal_audit", "kind": "evidence_rejected", "contains": "ended"},
    {"do": "evidence", "id": "E-Z", "key": "SBI-K2", "kind": "credit_advice", "at": "2026-03-01T10:00", "payload": {"utr": "UTR-Z", "amount_lakh": 15, "value_date": "2026-03-01", "narrative": "APP-Z"}},
    {"do": "allocate", "alloc_id": "AZ", "credit_id": "CR-UTR-Z", "obligation_id": "OZ", "amount_lakh": 15, "basis": "machine_reference", "at": "2026-03-01T10:05", "actor": "system:auto_match"},
    {"do": "entitlement", "obligation_id": "OZ", "basis": "Closure approved", "at": "2026-03-05T10:00", "actor": "section_officer:kiran"},
    {"do": "affidavit", "obligation_id": "OZ", "kind": "AFFIDAVIT-6", "format_ok": true, "at": "2026-03-05T10:01", "actor": "section_officer:kiran"},
    {"do": "authorise", "case_id": "RZ", "obligation_id": "OZ", "at": "2026-03-10T10:00", "approver": "deputy_director:meera"},
    {"note": "On 1 Apr the bank reports K2 was COMPROMISED from 15 Feb. Everything received through K2 on or after that date is now untrusted."},
    {"do": "compromise_signer", "key_id": "SBI-K2", "compromised_from": "2026-02-15T00:00", "at": "2026-04-01T09:00", "reason": "HSM credential leak reported by SBI"},
    {"expect": "confidence", "alloc": "AZ", "equals": "UNVERIFIED_SOURCE"},
    {"expect": "confidence", "alloc": "AY", "equals": "TRACEABLE"},
    {"expect": "notification", "to": "internal_audit", "kind": "evidence_invalidated", "contains": "E-Z"},
    {"expect": "notification", "to": "internal_audit", "kind": "refund_needs_review", "contains": "RZ"},
    {"expect": "error", "code": "GateBlocked", "step": {"do": "initiate", "refund_id": "RZ", "at": "2026-04-02T10:00", "actor": "finance_officer:ravi"}},
    {"note": "Attacker with K2 back-dates a message to 1 Jan. Validity is judged at receipt time, so it is still rejected."},
    {"expect": "error", "code": "InvalidEvidence", "step": {"do": "evidence", "id": "E-BACK", "key": "SBI-K2", "kind": "credit_advice", "at": "2026-04-02T11:00", "signed_at": "2026-01-01T00:00", "payload": {"utr": "UTR-BACK", "amount_lakh": 99, "value_date": "2026-01-01", "narrative": "APP-Z"}}},
    {"note": "Message changed after signing (amount edited in transit): signature fails."},
    {"do": "bank", "bank": "SBI", "key": "SBI-K3", "valid_from": "2026-04-01T00:00", "at": "2026-04-02T12:00"},
    {"expect": "error", "code": "InvalidEvidence", "step": {"do": "evidence", "id": "E-FORGE", "key": "SBI-K3", "kind": "credit_advice", "at": "2026-04-02T12:30", "forge_amount_lakh": 90, "payload": {"utr": "UTR-F", "amount_lakh": 9, "value_date": "2026-04-02", "narrative": "x"}}},
    {"expect": "chain", "valid": true},
    {"expect": "replay_matches"}
  ]
}
