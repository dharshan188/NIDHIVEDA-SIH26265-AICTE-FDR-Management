# Copy to .env and fill in. Never commit .env.
TL_ENV=dev                                   # dev enables /api/sim/* and the mock OIDC issuer; use "prod" to disable both
TL_DATABASE_URL=sqlite:///./trustledger.db   # or postgresql+psycopg://trustledger:CHANGE_ME@localhost:5432/trustledger
TL_SECRET_KEY=                               # 32+ random bytes, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
TL_DATA_KEY=                                 # Fernet key for TOTP secrets: `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
TL_SIM_BANK_SEED=                            # dev only: seed from which simulated bank signing keys are derived
TL_DEMO_PASSWORD=                            # dev only: password given to seeded demo accounts (random if empty)
TL_COOKIE_SECURE=true                        # keep true; browsers treat http://localhost as secure
TL_CHECKPOINT_PATH=~/.trust-ledger/checkpoints.jsonl   # off-host audit checkpoint file (demo grade)
TL_KERNEL_PATH=../trust-ledger-kernel
TL_OIDC_ISSUER=                              # empty in dev = use the local mock issuer
TL_OIDC_CLIENT_ID=trust-ledger
TL_OIDC_CLIENT_SECRET=
TL_PUBLIC_URL=http://localhost:5173
